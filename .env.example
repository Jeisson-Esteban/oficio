# Solo para desarrollo/CI: variables de entorno reales, leidas por
# AlmacenCredencialesLocal antes que nada (nucleo/configuracion/almacen-credenciales.ts).
# Para un profesional usando el sistema en su dia a dia, las credenciales se
# guardan CIFRADAS en disco via la interfaz web local (npm run interfaz) o la
# skill conectar-herramienta -- no hace falta tocar este archivo a mano.
# Copiar a ".env" y completar con credenciales reales. Nunca commitear ".env".
# Formato de las claves: <HERRAMIENTA>__<ALIAS_CUENTA>__<CAMPO> (ver nucleo/configuracion/variables-entorno.ts)
# "DEFAULT" es el alias que se usa si no se especifica una cuenta concreta.

# --- Notion ---
# 1. Crear una integración en https://www.notion.so/my-integrations
# 2. Copiar su "Internal Integration Secret"
# 3. Compartir la base de datos de fichas/registros con esa integración (··· -> Connections)
# 4. Copiar el id de la base de datos desde su URL
NOTION__DEFAULT__TOKEN=
NOTION__DEFAULT__DATABASE_ID=

# --- Google Calendar (Service Account) ---
# 1. Crear una Service Account en Google Cloud Console con la Calendar API habilitada
# 2. Si el calendario es de un Workspace con Domain-Wide Delegation, autorizar el scope
#    https://www.googleapis.com/auth/calendar para la Service Account
# 3. Compartir el calendario en cuestión con el client_email de la Service Account
#    (o usar SUBJECT si es Domain-Wide Delegation a nombre de otro usuario)
GOOGLE_CALENDAR__DEFAULT__CLIENT_EMAIL=
GOOGLE_CALENDAR__DEFAULT__PRIVATE_KEY=
GOOGLE_CALENDAR__DEFAULT__CALENDAR_ID=
GOOGLE_CALENDAR__DEFAULT__SUBJECT=
